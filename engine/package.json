    "seed": "tsx src/cli.ts seed",
    "ingest": "tsx src/cli.ts ingest",
    "export": "tsx src/cli.ts export",
    "retag": "tsx src/cli.ts retag",
    "relocate": "tsx src/cli.ts relocate",
    "reclassify": "tsx src/cli.ts reclassify",
    "refresh": "tsx src/cli.ts refresh",
    "notify": "tsx src/cli.ts notify",
    "logos": "tsx src/cli.ts logos",
    "archive:commit": "tsx src/cli.ts archive:commit",
    "archive:load": "tsx src/cli.ts archive:load",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aiengjobs/shared": "*",
    "@huggingface/transformers": "4.2.0",
    "onnxruntime-node": "1.24.3"
