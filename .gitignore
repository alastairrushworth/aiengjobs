node_modules/
dist/
.astro/
.output/

# SQLite database is carried between nightly runs as a release asset, never in the repo
*.db
*.db-shm
*.db-wal
*.sqlite

# The ~32MB snapshot is published on the detached `snapshot` branch, not in
# main's history (see scripts/publish.sh). Fetch it with:
#   npm run snapshot:fetch
# Its small companion, snapshot.meta.json, IS committed.
site/src/data/snapshot.json

# Phase 1 of the nightly writes the previous snapshot here for phase 2 to diff.
data/prev-snapshot.json

# Trained encoder weights (~600MB per run) and the ad corpus they train on.
# Both are reproducible from ml/gold/labels.jsonl + ml/train_encoder.py; only
# the small eval.json companion is worth committing.
ml/model*/*
!ml/model*/eval.json
!ml/model*/manifest.json
ml/ads/
__pycache__/

# secrets
.env
.env.*
!.env.example

# Google service-account keys. Downloaded from the Cloud console as
# <project>-<keyid>.json, which looks harmless enough to `git add -A` into a
# public repo. Root-anchored so it can only ever hide a key sitting where one
# lands by default, never a real file deeper in the tree.
/frontierroles-*.json
/*-service-account.json

.DS_Store
*.log

# wrangler dev's local miniflare state (caches, observability traces)
.wrangler/
ml/acceptance/ads/
ml/model_v3_candidate/

# Regenerated by ml/validate-labels.cjs from ml/labels/*.jsonl.
ml/labels-all.jsonl

# Default output of `npm run og:preview` — throwaway renders for eyeballing
# the share card layout.
og-preview/
