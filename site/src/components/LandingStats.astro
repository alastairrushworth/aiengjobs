---
import type { LandingStats } from "../lib/landingStats.ts";
import { kUsd } from "../lib/format.ts";
import { url } from "../lib/url.ts";

interface Props {
  stats: LandingStats;
  /** Noun phrase for the copy, e.g. "London, United Kingdom" or "AI Agents". */
  where: string;
}

const { stats, where } = Astro.props;

const pct = (n: number) => Math.round((n / Math.max(stats.total, 1)) * 100);

// Only the tiles we can actually fill — an empty "Median salary" box on a page
// where nobody publishes ranges is worse than not showing the tile.
const tiles: { label: string; value: string; note?: string }[] = [
  { label: "Open roles", value: String(stats.total) },
  stats.medianUsd !== null && {
    label: "Median salary",
    value: kUsd(stats.medianUsd),
    // The count, not the share. "16% publish a range" is the same styling as
    // "Open roles 120" while resting on 19 roles, and a reader has to do the
    // arithmetic to find that out. USD is stated because the figure is
    // FX-normalised: on the London page it sat above a column of £ ranges.
    note: `median of ${stats.pricedCount} priced role${stats.pricedCount === 1 ? "" : "s"}, USD`,
  },
  stats.remote > 0 && {
    label: "Remote",
    value: `${pct(stats.remote)}%`,
    // "15% hybrid" under a tile labelled "Remote" showing 15% reads as the same
    // number printed twice — on /ai-agent-jobs the two genuinely coincide, and
    // it looks like a bug until you check another page. Naming the second
    // figure's subject separates them.
    note: stats.hybrid > 0 ? `plus ${pct(stats.hybrid)}% hybrid` : "",
  },
  stats.topSkills.length > 0 && {
    label: "Top skill",
    value: stats.topSkills[0]!.name,
    note: `in ${pct(stats.topSkills[0]!.count)}% of roles`,
  },
].filter(Boolean) as { label: string; value: string; note?: string }[];
---

<section class="landing-stats" aria-label={`Hiring snapshot for ${where}`}>
  <dl class="tiles">
    {tiles.map((t) => (
      <div class="tile">
        <dt>{t.label}</dt>
        <dd>{t.value}</dd>
        {t.note && <p class="note">{t.note}</p>}
      </div>
    ))}
  </dl>

  {/* Each entry is one .item rather than a run of loose siblings, so the phone
      rule below can hide whole entries by position instead of counting links,
      separators and counts. They stay in the markup for crawlers either way. */}
  {stats.topCompanies.length > 0 && (
    <p class="line">
      <span class="lead">Hiring most:</span>
      {stats.topCompanies.map((c) => (
        <span class="item">
          {c.slug ? (
            <a href={url(`/companies/${c.slug}/`)}>{c.name}</a>
          ) : (
            <span>{c.name}</span>
          )}
          <span class="n">{c.count}</span>
        </span>
      ))}
    </p>
  )}

  {stats.topSkills.length > 1 && (
    <p class="line">
      <span class="lead">Common stack:</span>
      {/* Links, like the companies on the row above. These sat as plain text at
          the same weight, in the same shape of row, next to a row where every
          entry navigates — so the obvious next thought ("show me the Python
          ones") had nowhere to go. The card badges already use this exact URL,
          so the destination is one the board understands. */}
      {stats.topSkills.map((s) => (
        <span class="item">
          <a href={url(`/?skill=${encodeURIComponent(s.name)}`)}>{s.name}</a>
          <span class="n">{s.count}</span>
        </span>
      ))}
    </p>
  )}
</section>

<style>
  .landing-stats { margin: 20px 0 8px; }
  /* Flex rather than an auto-fit grid: the tile count varies (1–4, depending on
     what the landing can actually fill) so a grid leaves a dead panel whenever
     the last row is short — four tiles across three columns left "Top skill"
     beside a large empty box. Growing flex items fill the row instead. */
  .tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    margin: 0 0 16px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .tile { flex: 1 1 150px; background: var(--surface); padding: 12px 14px; }
  .tile dt {
    color: var(--muted);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 4px;
  }
  .tile dd {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .tile .note { margin: 2px 0 0; color: var(--muted); font-size: 0.75rem; }
  /* Flex-wrap with a column gap, and no separator character at all. There used
     to be a leading "·" on each entry so the mobile cap below could hide the
     tail without stranding a trailing one — but a leading separator means every
     line that wraps *starts* with "· ", which is what it did ("· Tool use 202"
     opening the second row). Gap does the same separating job, can't orphan
     onto either end of a line, and stays correct however many entries the
     phone rule hides. `white-space: nowrap` keeps each name glued to its count.
     (nowrap alone can't replace the flex wrap here — Astro emits no whitespace
     between the spans, so inline flow had no break opportunities at all and the
     line ran off the viewport.) */
  .line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    margin: 0 0 8px;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text);
  }
  .line .lead { color: var(--muted); }
  .line .item { white-space: nowrap; }
  .line .n { color: var(--muted); font-size: 0.78rem; margin-left: 3px; }
  /* inline-block + padding so these clear the 24px target floor (WCAG 2.2 SC
     2.5.8); at 0.9rem they were ~17px. The row gap is 4px vertical, so the
     padded boxes still don't touch.
     min-width covers the other axis: the padding only fixed the height, and a
     two-character skill ("Go", "R", "C") rendered a 19px-wide target. Centred
     so the short names don't sit off to one side of their own box. */
  .line a {
    color: var(--accent-text);
    display: inline-block;
    padding-block: 4px;
    min-width: 24px;
    text-align: center;
  }
  .line a:hover { text-decoration: underline; }

  /* On a phone this block sat between the hero and the listing at ~404px — ten
     skills wrap to five lines at 390px — and pushed every job card off the
     fold. The first four entries carry almost all of the signal ("mostly
     Python, mostly OpenAI"); the tail is a desktop luxury. Hidden, not dropped:
     the full list stays in the HTML for crawlers and for wider screens.
     .lead is child 1, so n+6 keeps four entries. */
  @media (max-width: 700px) {
    .landing-stats { margin: 14px 0 4px; }
    .tiles { margin-bottom: 12px; }
    .tile { padding: 10px 12px; }
    .line { line-height: 1.7; margin-bottom: 6px; }
    .line .item:nth-child(n + 6) { display: none; }
  }
</style>
