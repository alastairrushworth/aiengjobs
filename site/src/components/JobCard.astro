---
import type { Job } from "@aiengjobs/shared";
import { formatSalary, isNewJob, remoteLabel, seniorityLabel } from "../lib/format.ts";
import { generatedAt, fxRates } from "../lib/data.ts";
import CompanyLogo from "./CompanyLogo.astro";

/** Card mark size — set to the company line it now sits on. The mark used to
 *  own a 32px column down the left of the card, which pushed every title and
 *  badge right of a ragged edge and gave the logo more weight than the role.
 *  Inline at this size it reads as punctuation on the company name instead. */
const LOGO_PX = 20;

interface Props {
  job: Job;
  href: string;
}

const { job, href } = Astro.props;
const salary = formatSalary(job, fxRates);
const remote = remoteLabel(job.remoteType);
const sen = seniorityLabel(job.seniority);
// No "posted Xd ago" stamp on cards: nothing older than MAX_JOB_AGE_DAYS is
// listed at all now, so the only freshness distinction worth drawing is
// "just posted" — and the New badge already draws it. Showing both put "New"
// and "Posted today" side by side on every card of a newest-first list.
const isNew = isNewJob(job.postedAt, generatedAt);
---

<li>
  <a class="job-card" href={href}>
    <div class="top">
      <div class="head">
        <div class="title">{job.title}</div>
        <div class="company">
          <CompanyLogo name={job.companyName} slug={job.companySlug} size={LOGO_PX} />
          <span>{job.companyName}{job.locationRaw ? ` · ${job.locationRaw}` : ""}</span>
        </div>
      </div>
      {salary && <div class="salary">{salary}</div>}
    </div>
    <div class="meta">
      {isNew && <span class="badge new">New</span>}
      {remote && <span class="badge">{remote}</span>}
      {sen && <span class="badge">{sen}</span>}
      {job.skills.slice(0, 4).map((s) => <span class="badge skill">{s}</span>)}
    </div>
  </a>
</li>
