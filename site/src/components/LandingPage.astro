---
import type { Page } from "astro";
import type { Job } from "@aiengjobs/shared";
import type { Landing } from "../lib/landings.ts";
import Base from "../layouts/Base.astro";
import JobCard from "./JobCard.astro";
import JobFilters from "./JobFilters.astro";
import LandingStats from "./LandingStats.astro";
import BrowseNav from "./BrowseNav.astro";
import { url } from "../lib/url.ts";
import { jsonLdScript } from "../lib/jsonld.ts";
import { buildFilterOptions } from "../lib/filterOptions.ts";
import { computeLandingStats } from "../lib/landingStats.ts";
import { fxRates } from "../lib/data.ts";
import { CLUSTER_PAGES } from "../lib/clusters.ts";
import { LOCATION_LANDINGS } from "../lib/landings.ts";

interface Props {
  landing: Landing;
  page: Page<Job>;
}

const { landing, page } = Astro.props;

// Astro emits slice URLs without a trailing slash (trailingSlash: "ignore"),
// but GitHub Pages 301s that form — and canonicals, the sitemap and every other
// internal link here use the slash. Normalize so pagination doesn't hand
// crawlers a chain of redirects.
const slash = (u?: string) => (u && !u.endsWith("/") ? `${u}/` : u);
const prevUrl = slash(page.url.prev);
const nextUrl = slash(page.url.next);

const paged = page.lastPage > 1;
const pageSuffix = page.currentPage > 1 ? ` — page ${page.currentPage} of ${page.lastPage}` : "";
const title = `${landing.h1}${pageSuffix}`;

// Stats always describe the whole landing, not the current slice — someone on
// page 3 wants the same "roles in London" summary, and it keeps the numbers
// consistent across the sequence. Only rendered on page 1, where it's the
// distinguishing content; repeating it would make every slice near-duplicate.
const stats = page.currentPage === 1 ? computeLandingStats(landing.jobs, fxRates) : null;

// Each slice gets its own ItemList covering exactly what it renders — a
// numberOfItems that disagrees with the list is a structured-data error.
const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: title,
  numberOfItems: page.data.length,
  itemListElement: page.data.map((j, i) => ({
    "@type": "ListItem",
    position: page.start + i + 1,
    url: new URL(url(`/jobs/${j.slug}/`), Astro.site).href,
    name: `${j.title} — ${j.companyName}`,
  })),
};

// Cross-links: the other clusters, plus the biggest location pages. Capped so
// the foot of every listing page isn't a link farm. Kept in two labelled rows
// rather than one — the homepage already teaches "Browse by stack" vs "Browse
// by location", and flattening them here made 16 links read as an undifferen-
// tiated dump where a stack and a city looked like the same kind of thing.
const otherClusters = CLUSTER_PAGES.filter((p) => p.slug !== landing.slug);
const otherLocations = LOCATION_LANDINGS.filter((l) => l.slug !== landing.slug).slice(0, 8);
const stackLinks = otherClusters.map((p) => ({ href: url(`/${p.slug}/`), text: p.label }));
const locationLinks = otherLocations.map((l) => ({ href: url(`/${l.slug}/`), text: l.label }));

// Newer/Older alone costs 21 clicks to reach the last page of a 22-page
// landing. A windowed run of numbers puts any page one or two hops away while
// keeping the row short enough to fit a phone.
const pageHref = (n: number) =>
  n === 1 ? url(`/${landing.slug}/`) : url(`/${landing.slug}/${n}/`);

function pageWindow(current: number, last: number): (number | "gap")[] {
  const wanted = new Set<number>([1, last, current]);
  for (const n of [current - 1, current + 1]) {
    if (n > 1 && n < last) wanted.add(n);
  }
  const out: (number | "gap")[] = [];
  let prev = 0;
  for (const n of [...wanted].sort((a, b) => a - b)) {
    if (prev && n - prev > 1) out.push("gap");
    out.push(n);
    prev = n;
  }
  return out;
}
const pageNumbers = paged ? pageWindow(page.currentPage, page.lastPage) : [];

// Refining a landing is a page-1 affordance. Pages 2+ are slices of one
// ordering, and a filter there would have to either silently jump you back to
// the first page of a different list or paginate two ways at once; page 1 is
// also where search traffic lands and where the stats block already sits.
//
// Filter options and the payload are scoped to this landing, so "Senior (240)"
// counts senior roles in *this* list — a filter bar carrying whole-board counts
// would be a worse answer than no filter bar.
const filterOptions = page.currentPage === 1 ? buildFilterOptions(landing.jobs) : null;

const feedHref = url(`/${landing.slug}/rss.xml`);
const description = `${landing.intro} ${page.total} open role${page.total === 1 ? "" : "s"} right now.${
  page.currentPage > 1 ? ` Page ${page.currentPage} of ${page.lastPage}.` : ""
}`;
---

<Base title={title} description={description} prev={prevUrl} next={nextUrl} feed={feedHref} feedTitle={`${landing.h1} — aiengjobs`}>
  <section class="hero" style="padding-bottom:8px">
    <h1>{landing.h1}</h1>
    <p>{landing.intro}</p>
    {/* Page 1's range is stated by the filter bar's results line, which also
        keeps saying something true once you narrow it. Later pages have no
        filter bar, so the range stays here. */}
    <p class="count">
      {page.total} open role{page.total === 1 ? "" : "s"}
      {paged && page.currentPage > 1 && ` · showing ${page.start + 1}–${page.end + 1}`}
    </p>
  </section>

  {stats && <LandingStats stats={stats} where={landing.where} />}

  {filterOptions ? (
    <JobFilters
      src={url(`/${landing.slug}/jobs-data.json`)}
      jobBase={url("/jobs/")}
      logoBase={url("/logos/")}
      total={landing.jobs.length}
      initial={page.data.length}
      noun="roles"
      collapsible
      quiet
      hasPager={paged}
      {...filterOptions}
    >
      <p class="crumbs" slot="crumbs">
        <a class="back" href={url("/")}>← All jobs</a>
        <a class="feed" href={feedHref}>RSS feed</a>
      </p>
      <ul class="jobs" id="jobs">
        {page.data.map((job) => <JobCard job={job} href={url(`/jobs/${job.slug}/`)} />)}
      </ul>
    </JobFilters>
  ) : (
    <>
      <p class="crumbs">
        <a class="back" href={url("/")}>← All jobs</a>
        <a class="feed" href={feedHref}>RSS feed</a>
      </p>
      <ul class="jobs">
        {page.data.map((job) => <JobCard job={job} href={url(`/jobs/${job.slug}/`)} />)}
      </ul>
    </>
  )}
  {page.data.length === 0 && (
    <p class="empty">No open roles here right now.</p>
  )}

  {paged && (
    <nav class="pager" aria-label="Pagination">
      {prevUrl ? (
        <a rel="prev" href={prevUrl}>← Newer</a>
      ) : (
        <span class="disabled">← Newer</span>
      )}
      <span class="pager-nums">
        <span class="sr-only">Page {page.currentPage} of {page.lastPage}.</span>
        {pageNumbers.map((n) =>
          n === "gap" ? (
            <span class="pager-gap" aria-hidden="true">…</span>
          ) : n === page.currentPage ? (
            <span class="pager-num current" aria-current="page">{n}</span>
          ) : (
            <a class="pager-num" href={pageHref(n)}>
              <span class="sr-only">Page </span>{n}
            </a>
          ),
        )}
      </span>
      {nextUrl ? (
        <a rel="next" href={nextUrl}>Older →</a>
      ) : (
        <span class="disabled">Older →</span>
      )}
    </nav>
  )}

  <BrowseNav label="Browse by stack:" links={stackLinks} />
  {locationLinks.length > 0 && (
    <BrowseNav label="Browse by location:" links={locationLinks} compact ariaLabel="Browse by location" />
  )}

  <script type="application/ld+json" set:html={jsonLdScript(itemList)} is:inline />
</Base>

<style>
  .crumbs {
    display: flex;
    gap: 16px;
    align-items: baseline;
    margin: 8px 0;
  }
  .crumbs .feed { color: var(--muted); font-size: 0.85rem; }
  .crumbs .feed:hover { text-decoration: underline; }
  .empty { text-align: center; color: var(--muted); padding: 32px 0; }
  .pager {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    margin: 28px 0 4px;
    font-size: 0.9rem;
  }
  .pager a {
    color: var(--accent-text);
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    /* ≥44px tall so it's a comfortable touch target on a phone. */
    padding: 12px 18px;
  }
  .pager a:hover,
  .pager a:focus-visible { border-color: var(--accent); }
  .pager .disabled { color: var(--muted); padding: 12px 18px; }
  .pager-nums {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2px;
  }
  /* Numbers are plain targets, not the bordered buttons Newer/Older use — the
     border treatment on nine elements turns the pager into a wall of boxes. */
  .pager .pager-num {
    border: none;
    padding: 12px 4px;
    /* ≥44px wide so each digit is still a comfortable touch target. */
    min-width: 44px;
    text-align: center;
  }
  .pager .pager-num.current {
    color: var(--text);
    font-weight: 700;
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
  }
  .pager .pager-num:hover,
  .pager .pager-num:focus-visible { color: var(--text); background: var(--surface-2); }
  .pager-gap { color: var(--muted); }
  @media (max-width: 420px) {
    .pager { gap: 8px; }
    .pager a, .pager .disabled { padding: 12px 10px; }
    .pager .pager-num { min-width: 40px; padding: 12px 2px; }
  }
</style>
