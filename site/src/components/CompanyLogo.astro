---
import { url } from "../lib/url.ts";
import { logo } from "../lib/logos.ts";

interface Props {
  name: string;
  slug: string;
  /** Rendered box size in px. */
  size?: number;
}
const { name, slug, size = 44 } = Astro.props;
const entry = logo(slug);

// Decorative: the company name is always rendered next to this, so alt text
// would just make a screen reader say it twice.
const initial = name.trim().slice(0, 1).toUpperCase() || "?";
---

{
  entry ? (
    <img
      class="company-logo"
      src={url(`/logos/${entry.file}`)}
      alt=""
      width={size}
      height={size}
      loading="lazy"
      decoding="async"
      style={`--logo-size:${size}px`}
    />
  ) : (
    <span class="company-logo monogram" aria-hidden="true" style={`--logo-size:${size}px`}>
      {initial}
    </span>
  )
}

{/* The .company-logo styles live in global.css rather than a scoped block here.
    The homepage renders job cards twice — through this component on the server,
    and again in plain JS once the filter payload loads — and a scoped rule
    can't reach markup this component didn't create. Both paths emit exactly
    the markup above; keep them in step. */}
