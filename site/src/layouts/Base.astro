---
import "../styles/global.css";
import { url } from "../lib/url.ts";

interface Props {
  title: string;
  description?: string;
  /** Set on the homepage, which carries its own branded title. */
  noBrandSuffix?: boolean;
  /** Tombstone/error pages that search engines shouldn't index. */
  noindex?: boolean;
  /** Paginated sequences: adjacent slice URLs (already base-prefixed). */
  prev?: string;
  next?: string;
  /** RSS feed for this page (already base-prefixed), advertised to readers. */
  feed?: string;
  feedTitle?: string;
  /**
   * Point the canonical at a different page (already base-prefixed). Used by
   * duplicate ATS requisitions, which consolidate onto the newest of the set.
   */
  canonicalOverride?: string;
}

const {
  title,
  description = "The job board for AI developers — RAG, agents, evals, inference. Salary-transparent, no ghost jobs.",
  noBrandSuffix = false,
  noindex = false,
  prev,
  next,
  feed,
  feedTitle,
  canonicalOverride,
} = Astro.props;

const fullTitle = noBrandSuffix ? title : `${title} — frontierroles.com`;

// Canonical always uses the trailing-slash form GitHub Pages actually serves
// (directory URLs 301 to it), so we never canonicalize to a redirect.
const path = canonicalOverride ?? Astro.url.pathname;
const canonicalPath = path.endsWith("/") || /\.[a-z]+$/i.test(path) ? path : `${path}/`;
const canonical = new URL(canonicalPath, Astro.site).href;
const ogImage = new URL(url("/og-default.png"), Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {prev && <link rel="prev" href={new URL(prev, Astro.site).href} />}
    {next && <link rel="next" href={new URL(next, Astro.site).href} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={feedTitle ?? "frontierroles.com — newest AI engineering jobs"}
      href={new URL(feed ?? url("/rss.xml"), Astro.site).href}
    />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="icon" type="image/png" sizes="32x32" href={url("/favicon-32.png")} />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="frontierroles.com" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Google Analytics (gtag.js) — last in head so it never delays SEO tags -->
    <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-F8NGE6G65G"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-F8NGE6G65G");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={url("/")}>
          {/* Inlined rather than <img src="/favicon.svg">: two shapes cost less
              here than a second request would, and inlining lets the ring take
              currentColor so it tracks the header's text colour. */}
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <path
              d="M19.207 8.12 A10 10 0 1 0 19.207 23.88"
              fill="none"
              stroke="currentColor"
              stroke-width="2.9"
              stroke-linecap="round"
              opacity="0.55"
            />
            <circle cx="26" cy="16" r="4.4" fill="var(--accent)" />
          </svg>
          <span>frontierroles<span class="dot">.</span>com</span>
        </a>
        <nav class="site-nav" aria-label="Site">
          <a href={url("/")}>Jobs</a>
          <a href={url("/stats/")}>Stats</a>
          <a href={url("/mcp/")}>MCP</a>
        </nav>
      </div>
    </header>
    <main class="container" id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        {/* Every cluster page is linked from here, on every page. This is now
            the site-wide route to them: the "Browse by stack" rows that used to
            carry them are gone, and MLOps and Core ML were missing from this
            list — dropping those rows without adding them here would have left
            two landing pages with no internal links at all. */}
        <nav class="footer-nav" aria-label="Browse">
          <a href={url("/")}>All jobs</a>
          <a href={url("/stats/")}>Stats</a>
          <a href={url("/mcp/")}>MCP server</a>
          <a href={url("/llm-engineer-jobs/")}>LLM jobs</a>
          <a href={url("/rag-engineer-jobs/")}>RAG jobs</a>
          <a href={url("/ai-agent-jobs/")}>Agent jobs</a>
          <a href={url("/ai-eval-jobs/")}>Eval jobs</a>
          <a href={url("/inference-engineer-jobs/")}>Inference jobs</a>
          <a href={url("/fine-tuning-jobs/")}>Fine-tuning jobs</a>
          <a href={url("/mlops-engineer-jobs/")}>MLOps jobs</a>
          <a href={url("/machine-learning-engineer-jobs/")}>Core ML jobs</a>
          <a href={url("/remote-ai-jobs/")}>Remote AI jobs</a>
          <a href={url("/rss.xml")}>RSS</a>
        </nav>
        <p>
          AI Engineering Jobs · first-party ATS listings, salary-transparent, no ghost jobs.
          Listings are pulled nightly from company career sites — never scraped aggregators.
        </p>
      </div>
    </footer>
  </body>
</html>
