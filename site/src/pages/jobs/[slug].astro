---
import type { InferGetStaticPropsType } from "astro";
import Base from "../../layouts/Base.astro";
import JobCard from "../../components/JobCard.astro";
import {
  companyUrl,
  countryName,
  decodeEntities,
  formatSalary,
  postedAgo,
  remoteLabel,
  safeUrl,
  seniorityLabel,
} from "../../lib/format.ts";
import { url } from "../../lib/url.ts";
import { jsonLdScript } from "../../lib/jsonld.ts";
import { ogImagePath } from "../../lib/og/policy.ts";
import { payContext } from "../../lib/payContext.ts";
import { postingFacts, type DegreeLevel } from "../../lib/postingFacts.ts";
import PayBenchmark from "../../components/PayBenchmark.astro";
import AtAGlance from "../../components/AtAGlance.astro";
import { CLUSTER_PAGES } from "../../lib/clusters.ts";
import { buildJobTitles } from "../../lib/jobTitle.ts";
import CompanyLogo from "../../components/CompanyLogo.astro";
import { markupLogo } from "../../lib/logos.ts";
import {
  openJobs,
  closedJobs,
  delistedJobs,
  agedOutJobs,
  companyBySlug,
  generatedAt,
  fxRates,
  duplicateOf,
  MAX_JOB_AGE_DAYS,
} from "../../lib/data.ts";
import type { Job } from "@aiengjobs/shared";
import { hasUsableLocation } from "@aiengjobs/shared/indexable";

export function getStaticPaths() {
  // <title> needs whole-corpus knowledge: it trims over-long feed titles, but
  // only where the trim doesn't merge two distinct roles. See lib/jobTitle.
  const titles = buildJobTitles([...openJobs, ...closedJobs, ...delistedJobs, ...agedOutJobs]);

  // Two indexes over openJobs, built once.
  //
  // `related` runs for every page — 6,106 of them — and used to scan all 4,917
  // open roles two or three times inside each call, which is tens of millions
  // of comparisons for a handful of links. Both lookups are exact-match on a
  // key, so a Map answers them in the same order the array would.
  const byCompany = new Map<string, Job[]>();
  for (const j of openJobs) {
    const list = byCompany.get(j.companySlug);
    if (list) list.push(j);
    else byCompany.set(j.companySlug, [j]);
  }
  const byCluster = new Map<string, Job[]>();
  const position = new Map<string, number>();
  for (const [i, j] of openJobs.entries()) {
    position.set(j.slug, i);
    for (const c of j.clusters) {
      const list = byCluster.get(c);
      if (list) list.push(j);
      else byCluster.set(c, [j]);
    }
  }

  const related = (job: Job) => {
    const atCompany = (byCompany.get(job.companySlug) ?? [])
      .filter((j) => j.slug !== job.slug)
      .slice(0, 3);
    const elsewhere = (j: Job) => j.companySlug !== job.companySlug && j.slug !== job.slug;
    // Shared cluster is the good match, but 343 open roles (8%) carry no
    // cluster at all, and for those this returns nothing — which would leave
    // the page with "More at <company>" as its only way onward, a dead end for
    // anyone who isn't sold on the company. The newest roles elsewhere are the
    // weaker signal and only get used when the strong one has nothing to say.
    // (Role family used to fill this gap; it went with the Role type filter.)
    //
    // Picking the three has to stay a choice across *all* the job's clusters by
    // recency, not the first three of its first cluster — that would silently
    // re-rank every multi-cluster role. Each bucket is already newest-first, so
    // the three newest overall are somewhere in the first three of each: gather
    // that handful, then order it by position in openJobs.
    const seen = new Set<string>();
    const candidates: Job[] = [];
    for (const c of job.clusters) {
      let taken = 0;
      for (const j of byCluster.get(c) ?? []) {
        if (taken === 3) break;
        if (!elsewhere(j)) continue;
        taken++;
        if (seen.has(j.slug)) continue;
        seen.add(j.slug);
        candidates.push(j);
      }
    }
    const shared = candidates
      .sort((a, b) => position.get(a.slug)! - position.get(b.slug)!)
      .slice(0, 3);
    const similar = shared.length > 0 ? shared : openJobs.filter(elsewhere).slice(0, 3);
    return { atCompany, similar };
  };

  return [
    // Open roles get full, indexable pages.
    ...openJobs.map((job) => ({
      params: { slug: job.slug },
      props: {
        job,
        retired: null,
        pageTitle: titles.get(job.slug)!,
        ...related(job),
      },
    })),
    // Recently-closed roles keep a noindexed tombstone page instead of 404ing
    // links from search results, newsletters, and shares.
    ...closedJobs.map((job) => ({
      params: { slug: job.slug },
      props: {
        job,
        retired: "closed" as const,
        pageTitle: titles.get(job.slug)!,
        ...related(job),
      },
    })),
    // Roles the classifier has since ruled out of scope. Still live at the
    // ATS, so the apply link stays; the board just no longer lists them.
    ...delistedJobs.map((job) => ({
      params: { slug: job.slug },
      props: {
        job,
        retired: "delisted" as const,
        pageTitle: titles.get(job.slug)!,
        ...related(job),
      },
    })),
    // Roles that aged past MAX_JOB_AGE_DAYS. Same reasoning as the closed
    // tombstone — these URLs were listed and shared right up until the refresh
    // that dropped them — but the role itself is still live at the ATS, so the
    // page keeps its description and its apply link and only the board's
    // endorsement is withdrawn. See AGED_OUT_TOMBSTONE_DAYS.
    ...agedOutJobs.map((job) => ({
      params: { slug: job.slug },
      props: {
        job,
        retired: "aged-out" as const,
        pageTitle: titles.get(job.slug)!,
        ...related(job),
      },
    })),
  ];
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { job, retired, pageTitle, atCompany, similar } = Astro.props as Props;

// All three tombstone kinds are noindexed, drop their structured data and stay
// out of the sitemap. They differ in what's still true of the role: a closed
// one is gone from the employer's site (no description, no apply link); an
// aged-out one is still live and still applicable; a delisted one is still
// live and applicable too, but no longer something this board covers.
const closed = retired === "closed";
const agedOut = retired === "aged-out";
const delisted = retired === "delisted";
const isTombstone = retired !== null;

const salary = formatSalary(job, fxRates);
const applyHref = safeUrl(job.applyUrl);
const posted = postedAgo(job.postedAt, generatedAt);
const lastSeen = postedAgo(job.lastSeenAt, generatedAt);

// Structured "facts" surfaced at the top of the page. Country codes get a
// readable name; prefer the raw location string, else compose city + country.
const country = countryName(job.country);
const location =
  (job.locationRaw && decodeEntities(job.locationRaw)) ||
  [job.city, country].filter(Boolean).join(", ") ||
  null;
// What the advert asks for and offers, read out of its text — lib/postingFacts.
// The description is the employer's, and Google already has it from the
// employer; a reading of it (how much experience, whether a visa is on offer,
// how many days in the office) is something this page can add without
// inventing anything. Tombstones skip it: a closed role has no text left to
// read, and the other two kinds are off the board.
const reading = isTombstone ? { facts: [] } : postingFacts(job.descriptionText);

// Everything the page states about the role, as one "At a glance" list: the
// feed's own fields first (they are what the role *is*), then what was read out
// of the description. There used to be a grid of tiles for the first six and a
// separate section for the rest; to a reader "Level: Staff" and "Experience:
// 8+ years" are the same kind of answer, and tiles made fourteen of them a
// 700px wall on a phone. Label/value rows hold all of it in a third of that.
const facts: { label: string; value: string; tone?: "salary" | "muted" }[] = [
  // Honesty on a salary-transparent board: say so when a range isn't published
  // rather than silently omitting the row.
  salary
    ? { label: "Salary", value: salary, tone: "salary" as const }
    : { label: "Salary", value: "Not published", tone: "muted" as const },
  location && { label: "Location", value: location },
  remoteLabel(job.remoteType) && {
    label: "Work type",
    value: remoteLabel(job.remoteType)!,
  },
  seniorityLabel(job.seniority) && {
    label: "Level",
    value: seniorityLabel(job.seniority)!,
  },
  posted && { label: "Posted", value: posted },
  // When the nightly poll last found the role still on its feed. The one
  // freshness fact this board can state that the employer's page cannot, and
  // the answer to "is this still open?" — the question every stale aggregator
  // listing fails. Open roles only (the exporter drops it on tombstones), and
  // only on snapshots new enough to carry it.
  !isTombstone && lastSeen && { label: "Verified live", value: lastSeen },
  ...reading.facts.map((f) => ({ label: f.label, value: f.value })),
].filter(Boolean) as { label: string; value: string; tone?: "salary" | "muted" }[];

// Cap the skill wall; the long tail adds noise more than signal.
const MAX_SKILLS = 16;
const skills = job.skills.slice(0, MAX_SKILLS);
const moreSkills = job.skills.length - skills.length;

// Where the board files this role. The clusters were always computed and
// always drove the landing pages, but the page never showed them — so the
// one piece of classification the board adds to an employer's posting was
// invisible on the posting itself, and the cluster pages had no link from
// the roles they list. Open roles only: a tombstone is off the board.
const clusterLinks = isTombstone
  ? []
  : CLUSTER_PAGES.filter((p) => job.clusters.includes(p.id)).map((p) => ({
      href: url(`/${p.slug}/`),
      label: p.label,
    }));

// Pay against the rest of the board — see lib/payBenchmark.ts. Phrased from the
// role's side when it has a range, from the pool's side when it doesn't (then
// the useful fact is what comparable roles pay and how many say so). For the
// half of the board that publishes no pay it is the only pay information on
// the page. Tombstones skip it: comparing a closed role to the live board is
// trivia.
const pay = isTombstone ? null : payContext(job);


// Render the description as real paragraphs + bullet lists. The text carries
// newlines, with list items prefixed by a bullet/dash marker (see stripHtml).
const BULLET_RE = /^\s*(?:[•·▪◦‣*]|[-–—](?=\s))\s*/;
type Block = { type: "p"; text: string } | { type: "ul"; items: string[] };
const blocks: Block[] = [];
for (const line of decodeEntities(job.descriptionText ?? "").split("\n")) {
  const trimmed = line.trim();
  if (!trimmed) continue;
  if (BULLET_RE.test(trimmed)) {
    const item = trimmed.replace(BULLET_RE, "").trim();
    if (!item) continue;
    const last = blocks[blocks.length - 1];
    if (last && last.type === "ul") last.items.push(item);
    else blocks.push({ type: "ul", items: [item] });
  } else {
    blocks.push({ type: "p", text: trimmed });
  }
}

// JobPosting structured data (JSON-LD) — spec §8. Complete enough for Google
// Jobs eligibility: description, jobLocation (non-remote), validThrough.
// Only emitted for open roles (tombstones are noindexed).
const DAY_MS = 86_400_000;
// A dead-man's switch on the whole pipeline: `validThrough` in the past is one
// of Google's three sanctioned ways to retire a JobPosting, and the only one
// that keeps working when we can't reach Google. Every rebuild pushes it
// forward for roles that are still open, so the moment we stop refreshing a
// listing it retires itself.
//
// The window has to clear Googlebot's actual return interval, or it retires
// live roles instead. That stopped being true after the 2026-08-22 demotion:
// crawl fell from ~1.7K requests/day to ~350 against 4,054 sitemap URLs, so a
// job page now waits two weeks or more between fetches. At 10 days the board's
// most-seen role (1,534 impressions) was last crawled 15 Aug carrying a
// validThrough of 25 Aug — expired in the index for a fortnight while open on
// the site — and Job Postings valid items fell from ~90 to 8 over that window.
// 30 days clears the current interval with room to spare and still retires a
// dead pipeline inside a month.
const VALID_THROUGH_DAYS = 30;
// No per-role override: nothing in the pipeline ever set jobs.expires_at, so
// the `job.expiresAt ?? …` this replaced had exactly one live branch while
// implying the engine supplied a per-role expiry.
const validThrough = new Date(
  Date.parse(generatedAt) + VALID_THROUGH_DAYS * DAY_MS,
).toISOString();
// Google's credentialCategory vocabulary has one value above a bachelor's.
const DEGREE_CREDENTIAL: Record<DegreeLevel, string> = {
  bachelor: "bachelor degree",
  master: "postgraduate degree",
  phd: "postgraduate degree",
};
const PERIOD_UNIT: Record<string, string> = {
  year: "YEAR", month: "MONTH", day: "DAY", hour: "HOUR",
};
// Google's employmentType enum, best-effort from seniority/title. FULL_TIME is
// the safe default — these feeds are overwhelmingly full-time salaried roles.
const employmentType =
  job.seniority === "intern" || /\bintern(ship)?\b/i.test(job.title)
    ? "INTERN"
    : /\bcontract(or)?\b/i.test(job.title)
      ? "CONTRACTOR"
      : /\bpart[\s-]?time\b/i.test(job.title)
        ? "PART_TIME"
        : "FULL_TIME";

// Google wants the description as HTML. The snapshot carries plain text (with
// newline/bullet structure), so rebuild simple markup from the same blocks the
// page renders. Raw tags are safe here: jsonLdScript escapes the JSON string.
const escapeHtml = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const descriptionHtml = blocks
  .map((b) =>
    b.type === "ul"
      ? `<ul>${b.items.map((it) => `<li>${escapeHtml(it)}</li>`).join("")}</ul>`
      : `<p>${escapeHtml(b.text)}</p>`,
  )
  .join("");

const company = companyBySlug.get(job.companySlug);
const companySameAs = companyUrl(company?.domain);
const markLogo = markupLogo(job.companySlug);
const logoUrl = markLogo ? new URL(url(`/logos/${markLogo.file}`), Astro.site).href : null;
const pageUrl = new URL(url(`/jobs/${job.slug}/`), Astro.site).href;

// One of several identical requisitions for the same role at the same site?
// Consolidate onto the newest rather than letting them compete with each other
// in search. The page stays live and applicable — it just stops claiming to be
// the canonical one, and drops the JobPosting markup so Google has a single
// listing for the role instead of six.
const dupCanonicalSlug = isTombstone ? null : duplicateOf(job);

// Google requires a resolvable location, and both shapes need a country:
// TELECOMMUTE roles turn it into applicantLocationRequirements, everything else
// into jobLocation.address, where addressCountry is the only required field.
// A posting without one would be a guaranteed Search Console error, so emit no
// JobPosting at all rather than a half-valid one.
// Shared with the engine, which must predict this page's verdict exactly before
// submitting the URL to Google's Indexing API.
const locatable = hasUsableLocation(job);

const jsonLd: Record<string, unknown> | null = isTombstone || dupCanonicalSlug || !locatable
  ? null
  : {
      "@context": "https://schema.org/",
      "@type": "JobPosting",
      title: job.title,
      description:
        descriptionHtml ||
        `<p>${escapeHtml(`${job.title} at ${job.companyName}. Apply on the company's site.`)}</p>`,
      identifier: {
        "@type": "PropertyValue",
        name: job.companyName,
        value: job.slug,
      },
      url: pageUrl,
      hiringOrganization: {
        "@type": "Organization",
        name: job.companyName,
        // Shape-checked, like the company page's own link — an unvalidated
        // domain here became a broken sameAs in the published markup.
        ...(companySameAs ? { sameAs: `${companySameAs}/` } : {}),
        // Only claimed when we hold the bytes and render them on this page —
        // Google expects markup to reflect visible content, and a logo URL we
        // haven't verified would be a 404 in the index.
        ...(logoUrl ? { logo: logoUrl } : {}),
      },
      employmentType,
      // The board's own extraction, in the schema.org property meant for it.
      // Google's JobPosting rich result does not read it; it is here so the
      // page's added data is machine-readable, not only visible.
      ...(job.skills.length ? { skills: job.skills.join(", ") } : {}),
      // The reading above, in the JobPosting properties Google documents for it.
      // Only the plain cases: `minYears` is absent for "preferred" figures and
      // degree ladders, `requiredDegree` for roles aimed at students.
      ...(reading.minYears !== undefined
        ? {
            experienceRequirements: {
              "@type": "OccupationalExperienceRequirements",
              monthsOfExperience: reading.minYears * 12,
            },
          }
        : {}),
      ...(reading.requiredDegree
        ? {
            educationRequirements: {
              "@type": "EducationalOccupationalCredential",
              credentialCategory: DEGREE_CREDENTIAL[reading.requiredDegree],
            },
          }
        : {}),
      // Google requires both of the above alongside this one.
      ...(reading.experienceInPlaceOfEducation &&
      reading.minYears !== undefined &&
      reading.requiredDegree
        ? { experienceInPlaceOfEducation: true }
        : {}),
      // datePosted is required for the rich result; first-seen is the honest
      // fallback when a feed carries no posted date.
      datePosted: job.postedAt ?? job.ingestedAt,
      validThrough,
      directApply: false,
    };
if (jsonLd) {
  // Unconditional on both branches: `locatable` above has already established
  // that job.country is set, and it is the one field Google actually requires
  // of either shape. Guarding it again would only re-open the gap that put
  // "Missing field addressCountry" in Search Console — an address built from
  // whichever of city/region/country happened to be present.
  if (job.remoteType === "remote") {
    jsonLd.jobLocationType = "TELECOMMUTE";
    jsonLd.applicantLocationRequirements = {
      "@type": "Country",
      name: country ?? job.country,
    };
  } else {
    jsonLd.jobLocation = {
      "@type": "Place",
      address: {
        "@type": "PostalAddress",
        ...(job.city ? { addressLocality: job.city } : {}),
        ...(job.region ? { addressRegion: job.region } : {}),
        addressCountry: job.country,
      },
    };
  }
  if ((job.salaryMin || job.salaryMax) && salary) {
    jsonLd.baseSalary = {
      "@type": "MonetaryAmount",
      currency: job.salaryCurrency ?? "USD",
      value: {
        "@type": "QuantitativeValue",
        minValue: job.salaryMin ?? job.salaryMax,
        maxValue: job.salaryMax ?? job.salaryMin,
        unitText: PERIOD_UNIT[job.salaryPeriod ?? "year"] ?? "YEAR",
      },
    };
  }
}

// The <title> is computed across the whole corpus in getStaticPaths so that
// trimming long feed titles can't silently merge two distinct roles.

// Tombstones can outlive their company page (it's only built while the company
// has open roles) — don't link into a 404.
const companyPageExists = openJobs.some((j) => j.companySlug === job.companySlug);

// Breadcrumbs replace the raw URL in the SERP, which is worth having on slugs
// this long. The company page is the honest parent — a role sits in several
// clusters, so no single cluster page is "the" one above it — and it is only
// claimed when that page exists (see companyPageExists). Suppressed on the
// same pages as the JobPosting: a tombstone or a duplicate shouldn't be
// advertising a hierarchy it isn't part of.
const breadcrumbJsonLd =
  isTombstone || dupCanonicalSlug
    ? null
    : {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "AI engineering jobs",
            item: new URL(url("/"), Astro.site).href,
          },
          ...(companyPageExists
            ? [
                {
                  "@type": "ListItem",
                  position: 2,
                  name: job.companyName,
                  item: new URL(url(`/companies/${job.companySlug}/`), Astro.site).href,
                },
              ]
            : []),
          {
            "@type": "ListItem",
            position: companyPageExists ? 3 : 2,
            name: job.title,
            item: pageUrl,
          },
        ],
      };

const descBits = [
  `${job.title} at ${job.companyName}`,
  [location, remoteLabel(job.remoteType)].filter(Boolean).join(", "),
  salary,
  job.skills.length ? `Skills: ${job.skills.slice(0, 3).join(", ")}` : null,
].filter(Boolean);
const metaDescription = `${descBits.join(" — ")}.`.slice(0, 300);

// The card this role's links unfurl with. ogImagePath falls back through the
// role's cluster to the site default, so this is always a URL the build emits.
const ogImage = ogImagePath(job);
const ogImageAlt = `${job.title} at ${job.companyName}${location ? `, ${location}` : ""}${
  salary ? ` — ${salary}` : ""
}`;
---

<Base
  title={pageTitle}
  description={metaDescription}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  noindex={isTombstone}
  canonicalOverride={dupCanonicalSlug ? url(`/jobs/${dupCanonicalSlug}/`) : undefined}
>
  <article class="job-detail">
    <p>
      <a class="back" href={url("/")} data-back data-jobs-base={url("/jobs/")}>
        <span class="arrow" aria-hidden="true">←</span><span class="back-label">All jobs</span>
      </a>
    </p>
    {closed && (
      <p class="closed-banner" role="status">
        This role has closed — it no longer appears on {job.companyName}'s careers site.
        {similar.length > 0 && "Similar open roles are listed below."}
      </p>
    )}
    {/* Deliberately not the closed wording: this requisition is still up. What
        expired is the board's willingness to list it — see MAX_JOB_AGE_DAYS.
        Say which, so someone arriving from an old link can judge for
        themselves rather than being told something untrue. */}
    {agedOut && (
      <p class="closed-banner" role="status">
        This role has been open for more than {MAX_JOB_AGE_DAYS} days, so it's no longer
        listed on the board — a requisition nobody has refreshed in that long is often
        no longer live. It's still on {job.companyName}'s careers site and you can
        still apply.
        {similar.length > 0 && " Fresher roles are listed below."}
      </p>
    )}
    {/* Not a judgement on the role — the board's scope is narrow (frontier AI
        engineering) and its classifier moves as that scope is refined. Say
        what changed and what didn't: the requisition is still up. */}
    {delisted && (
      <p class="closed-banner" role="status">
        This role is no longer listed on the board — on a closer look it sits outside
        the AI-engineering roles this board covers. It's still on {job.companyName}'s
        careers site and you can still apply.
        {similar.length > 0 && " Roles the board does cover are listed below."}
      </p>
    )}
    <h1>{job.title}</h1>
    <div class="company-row">
      <CompanyLogo name={job.companyName} slug={job.companySlug} size={40} />
      <p class="company">
        {companyPageExists ? (
          <a href={url(`/companies/${job.companySlug}/`)}>{job.companyName}</a>
        ) : (
          job.companyName
        )}
      </p>
    </div>
    <section class="role-panel">
      <div class="panel-section">
        <h2>At a glance</h2>
        <AtAGlance
          facts={facts}
          skills={skills}
          moreSkills={moreSkills}
          clusterLinks={clusterLinks}
        />
      </div>
      {pay && (
        <div class="panel-section">
          <h2>How the pay compares</h2>
          <PayBenchmark pay={pay} />
        </div>
      )}
    </section>
    {!closed && applyHref && (
      <p class="apply-wrap top-apply">
        <a class="apply" href={applyHref} target="_blank" rel="noopener noreferrer nofollow"
           data-job={job.slug} data-company={job.companyName}>
          Apply on company site <span aria-hidden="true">→</span><span class="sr-only">(opens in new tab)</span>
        </a>
      </p>
    )}
    {blocks.length > 0 && <h2 class="desc-title">Job description</h2>}
    {blocks.length > 0 ? (
      <div class="desc">
        {blocks.map((b) =>
          b.type === "ul" ? (
            <ul>{b.items.map((it) => <li>{it}</li>)}</ul>
          ) : (
            <p>{b.text}</p>
          ),
        )}
      </div>
    ) : (
      !closed && (
        <p class="desc no-desc">
          The full job description is on {job.companyName}'s careers site — use the
          apply link to read it.
        </p>
      )
    )}
    {!closed && applyHref && blocks.length > 0 && (
      <p class="apply-wrap">
        <a class="apply" href={applyHref} target="_blank" rel="noopener noreferrer nofollow"
           data-job={job.slug} data-company={job.companyName}>
          Apply on company site <span aria-hidden="true">→</span><span class="sr-only">(opens in new tab)</span>
        </a>
      </p>
    )}
  </article>

  {(atCompany.length > 0 || similar.length > 0) && (
    <aside class="related">
      {atCompany.length > 0 && (
        <>
          <h2>More at {job.companyName}</h2>
          <ul class="jobs">
            {atCompany.map((j) => (
              <JobCard job={j} href={url(`/jobs/${j.slug}/`)} />
            ))}
          </ul>
        </>
      )}
      {similar.length > 0 && (
        <>
          <h2>Similar roles</h2>
          <ul class="jobs">
            {similar.map((j) => (
              <JobCard job={j} href={url(`/jobs/${j.slug}/`)} />
            ))}
          </ul>
        </>
      )}
    </aside>
  )}

  {/* "All jobs" always went to an unfiltered home page — so someone who had
      narrowed the board to remote Rust roles, opened one and wanted the next
      lost their filters, their page and their place. When they arrived from one
      of the board's own lists, take them back *to it*: the filters live in that
      URL and the browser restores the scroll. Arriving any other way (search, a
      share, a new tab, another job page) leaves the plain link alone, as does
      having no script. */}
  <script is:inline>
    (() => {
      const link = document.querySelector("a.back[data-back]");
      if (!link || !document.referrer || history.length < 2) return;
      let from;
      try {
        from = new URL(document.referrer);
      } catch {
        return;
      }
      if (from.origin !== location.origin || from.pathname.startsWith(link.dataset.jobsBase)) return;
      link.querySelector(".back-label").textContent = "Back to results";
      link.addEventListener("click", (e) => {
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        history.back();
      });
    })();
  </script>

  {jsonLd && (
    <script type="application/ld+json" set:html={jsonLdScript(jsonLd)} is:inline />
  )}
  {breadcrumbJsonLd && (
    <script type="application/ld+json" set:html={jsonLdScript(breadcrumbJsonLd)} is:inline />
  )}
</Base>

<style>
  /* Centred in the 1040px container rather than pinned left. Left-aligned, the
     720px column left ~300px of empty page down the right-hand side for the
     full height of every job page, which grows to ~740px of asymmetry at 1920
     and reads as a layout that lost its second column. */
  .job-detail { max-width: 720px; margin-inline: auto; padding: 32px 0 0; }
  .job-detail h1 {
    font-size: 1.8rem;
    letter-spacing: -0.02em;
    margin: 12px 0 6px;
    overflow-wrap: anywhere;
  }
  .company-row { display: flex; align-items: center; gap: 12px; margin: 0 0 16px; }
  .job-detail .company { margin: 0; overflow-wrap: anywhere; }
  .job-detail .company a { color: var(--accent-text); }
  .job-detail .company a:hover { text-decoration: underline; }
  .closed-banner {
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    padding: 12px 16px;
    color: var(--text);
    margin: 16px 0 0;
  }
  /* What the board adds to the employer's posting, set apart from the
     employer's copy that follows by the accent rule down its left edge: a
     reading of the advert, then the pay of comparable roles. One panel rather
     than two — a second border and a second margin bought nothing. */
  .role-panel {
    margin: 0;
    padding: 0 18px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    background: var(--surface-2);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .panel-section { padding: 12px 0 14px; }
  .panel-section + .panel-section { border-top: 1px solid var(--border); }
  .role-panel h2 { font-size: 1rem; margin: 0 0 6px; letter-spacing: -0.01em; }
  .desc-title { font-size: 1.1rem; margin: 32px 0 0; letter-spacing: -0.01em; }
  .desc-title + .desc { margin-top: 12px; }
  .desc { margin-top: 28px; color: var(--text); line-height: 1.7; }
  /* The description is the longest prose on the site. At the column's full
     720px it set ~88 characters a line, well past the ~65–75 the eye tracks
     comfortably; ch units hold the measure whatever the font does. The facts
     grid and the apply button keep the full width — only running text needs
     the shorter line. */
  /* overflow-wrap: ATS descriptions routinely carry bare URLs, and an unbroken
     48-character one sets the min-content width of the whole article — 8% of
     open roles carry a token of 40+ characters. At 320px that forced 54px of
     horizontal scroll on the job page (WCAG 1.4.10 Reflow, which also covers
     200% zoom at 640px). Every other text container already guards this: the
     h1 above, .job-detail .company, and both .job-card fields in global.css. */
  .desc p, .desc li { max-width: 66ch; overflow-wrap: anywhere; }
  .desc.no-desc { color: var(--muted); }
  .desc p { margin: 0 0 14px; }
  .desc ul { margin: 0 0 14px; padding-left: 1.25rem; }
  .desc li { margin: 0 0 6px; }
  .desc li:last-child { margin-bottom: 0; }
  .desc > :last-child { margin-bottom: 0; }
  .apply-wrap { margin-top: 28px; }
  .apply-wrap.top-apply { margin-top: 20px; }
  .apply {
    display: inline-block;
    background: var(--accent-strong);
    color: #fff;
    padding: 12px 20px;
    border-radius: 10px;
    font-weight: 600;
  }
  .apply:hover { filter: brightness(1.12); }
  .related { max-width: 720px; margin-inline: auto; margin-top: 40px; }
  .related h2 { font-size: 1.1rem; margin: 24px 0 12px; }
</style>
