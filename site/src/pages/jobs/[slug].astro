---
import type { InferGetStaticPropsType } from "astro";
import Base from "../../layouts/Base.astro";
import JobCard from "../../components/JobCard.astro";
import {
  countryName,
  decodeEntities,
  formatSalary,
  postedAgo,
  remoteLabel,
  roleType,
  safeUrl,
  seniorityLabel,
} from "../../lib/format.ts";
import { url } from "../../lib/url.ts";
import { jsonLdScript } from "../../lib/jsonld.ts";
import { openJobs, closedJobs, companies, generatedAt, fxRates } from "../../lib/data.ts";
import type { Job } from "@aiengjobs/shared";

export function getStaticPaths() {
  // Same title + company across several locations (common for multi-office
  // postings) would otherwise emit identical <title> tags; flag them so the
  // page can disambiguate with the location.
  const titleCount = new Map<string, number>();
  for (const j of [...openJobs, ...closedJobs]) {
    const k = `${j.title}·${j.companyName}`;
    titleCount.set(k, (titleCount.get(k) ?? 0) + 1);
  }
  const dupTitle = (job: Job) =>
    (titleCount.get(`${job.title}·${job.companyName}`) ?? 0) > 1;

  const related = (job: Job) => {
    const atCompany = openJobs
      .filter((j) => j.companySlug === job.companySlug && j.slug !== job.slug)
      .slice(0, 3);
    const similar = openJobs
      .filter(
        (j) =>
          j.companySlug !== job.companySlug &&
          j.slug !== job.slug &&
          j.clusters.some((c) => job.clusters.includes(c)),
      )
      .slice(0, 3);
    return { atCompany, similar };
  };

  return [
    // Open roles get full, indexable pages.
    ...openJobs.map((job) => ({
      params: { slug: job.slug },
      props: { job, closed: false, dupTitle: dupTitle(job), ...related(job) },
    })),
    // Recently-closed roles keep a noindexed tombstone page instead of 404ing
    // links from search results, newsletters, and shares.
    ...closedJobs.map((job) => ({
      params: { slug: job.slug },
      props: { job, closed: true, dupTitle: dupTitle(job), ...related(job) },
    })),
  ];
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { job, closed, dupTitle, atCompany, similar } = Astro.props as Props;

const salary = formatSalary(job, fxRates);
const role = roleType(job);
const applyHref = safeUrl(job.applyUrl);
const posted = postedAgo(job.postedAt, generatedAt);

// Structured "facts" surfaced at the top of the page. Country codes get a
// readable name; prefer the raw location string, else compose city + country.
const country = countryName(job.country);
const location =
  (job.locationRaw && decodeEntities(job.locationRaw)) ||
  [job.city, country].filter(Boolean).join(", ") ||
  null;
const facts: { label: string; value: string; muted?: boolean }[] = [
  // Honesty on a salary-transparent board: say so when a range isn't published
  // rather than silently omitting the row.
  salary
    ? { label: "Salary", value: salary }
    : { label: "Salary", value: "Not published", muted: true },
  location && { label: "Location", value: location },
  remoteLabel(job.remoteType) && {
    label: "Work type",
    value: remoteLabel(job.remoteType)!,
  },
  seniorityLabel(job.seniority) && {
    label: "Level",
    value: seniorityLabel(job.seniority)!,
  },
  role && role !== "Other" && { label: "Role", value: role },
  posted && { label: "Posted", value: posted },
].filter(Boolean) as { label: string; value: string; muted?: boolean }[];

// Cap the skill wall; the long tail adds noise more than signal.
const MAX_SKILLS = 16;
const skills = job.skills.slice(0, MAX_SKILLS);
const moreSkills = job.skills.length - skills.length;

// Render the description as real paragraphs + bullet lists. The text carries
// newlines, with list items prefixed by a bullet/dash marker (see stripHtml).
const BULLET_RE = /^\s*(?:[•·▪◦‣*]|[-–—](?=\s))\s*/;
type Block = { type: "p"; text: string } | { type: "ul"; items: string[] };
const blocks: Block[] = [];
for (const line of decodeEntities(job.descriptionText ?? "").split("\n")) {
  const trimmed = line.trim();
  if (!trimmed) continue;
  if (BULLET_RE.test(trimmed)) {
    const item = trimmed.replace(BULLET_RE, "").trim();
    if (!item) continue;
    const last = blocks[blocks.length - 1];
    if (last && last.type === "ul") last.items.push(item);
    else blocks.push({ type: "ul", items: [item] });
  } else {
    blocks.push({ type: "p", text: trimmed });
  }
}

// JobPosting structured data (JSON-LD) — spec §8. Complete enough for Google
// Jobs eligibility: description, jobLocation (non-remote), validThrough.
// Only emitted for open roles (tombstones are noindexed).
const DAY_MS = 86_400_000;
// Deliberately short. Every rebuild pushes this forward for roles that are still
// open, so nothing legitimate expires — but the moment we stop refreshing a
// listing (role closed, or the whole pipeline died) Google stops showing it
// within days instead of weeks. `validThrough` in the past is one of Google's
// three sanctioned ways to retire a JobPosting, and it's the only one that keeps
// working without us being able to reach Google.
const VALID_THROUGH_DAYS = 10;
const validThrough =
  job.expiresAt ??
  new Date(Date.parse(generatedAt) + VALID_THROUGH_DAYS * DAY_MS).toISOString();
const PERIOD_UNIT: Record<string, string> = {
  year: "YEAR", month: "MONTH", day: "DAY", hour: "HOUR",
};
// Google's employmentType enum, best-effort from seniority/title. FULL_TIME is
// the safe default — these feeds are overwhelmingly full-time salaried roles.
const employmentType =
  job.seniority === "intern" || /\bintern(ship)?\b/i.test(job.title)
    ? "INTERN"
    : /\bcontract(or)?\b/i.test(job.title)
      ? "CONTRACTOR"
      : /\bpart[\s-]?time\b/i.test(job.title)
        ? "PART_TIME"
        : "FULL_TIME";

// Google wants the description as HTML. The snapshot carries plain text (with
// newline/bullet structure), so rebuild simple markup from the same blocks the
// page renders. Raw tags are safe here: jsonLdScript escapes the JSON string.
const escapeHtml = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const descriptionHtml = blocks
  .map((b) =>
    b.type === "ul"
      ? `<ul>${b.items.map((it) => `<li>${escapeHtml(it)}</li>`).join("")}</ul>`
      : `<p>${escapeHtml(b.text)}</p>`,
  )
  .join("");

const company = companies.find((c) => c.slug === job.companySlug);
const pageUrl = new URL(url(`/jobs/${job.slug}/`), Astro.site).href;

// Google requires a resolvable location: TELECOMMUTE roles need
// applicantLocationRequirements (we derive it from country), everything else
// needs a jobLocation. A posting with neither would be a guaranteed Search
// Console error, so emit no JobPosting at all rather than a half-valid one.
const hasUsableLocation =
  job.remoteType === "remote"
    ? Boolean(job.country)
    : Boolean(job.city || job.region || job.country);

const jsonLd: Record<string, unknown> | null = closed || !hasUsableLocation
  ? null
  : {
      "@context": "https://schema.org/",
      "@type": "JobPosting",
      title: job.title,
      description:
        descriptionHtml ||
        `<p>${escapeHtml(`${job.title} at ${job.companyName}. Apply on the company's site.`)}</p>`,
      identifier: {
        "@type": "PropertyValue",
        name: job.companyName,
        value: job.slug,
      },
      url: pageUrl,
      hiringOrganization: {
        "@type": "Organization",
        name: job.companyName,
        ...(company?.domain ? { sameAs: `https://${company.domain}/` } : {}),
        ...(company?.logoUrl ? { logo: company.logoUrl } : {}),
      },
      employmentType,
      // datePosted is required for the rich result; first-seen is the honest
      // fallback when a feed carries no posted date.
      datePosted: job.postedAt ?? job.ingestedAt,
      validThrough,
      directApply: false,
    };
if (jsonLd) {
  if (job.remoteType === "remote") {
    jsonLd.jobLocationType = "TELECOMMUTE";
    if (job.country) {
      jsonLd.applicantLocationRequirements = {
        "@type": "Country",
        name: country ?? job.country,
      };
    }
  } else if (job.city || job.region || job.country) {
    jsonLd.jobLocation = {
      "@type": "Place",
      address: {
        "@type": "PostalAddress",
        ...(job.city ? { addressLocality: job.city } : {}),
        ...(job.region ? { addressRegion: job.region } : {}),
        ...(job.country ? { addressCountry: job.country } : {}),
      },
    };
  }
  if ((job.salaryMin || job.salaryMax) && salary) {
    jsonLd.baseSalary = {
      "@type": "MonetaryAmount",
      currency: job.salaryCurrency ?? "USD",
      value: {
        "@type": "QuantitativeValue",
        minValue: job.salaryMin ?? job.salaryMax,
        maxValue: job.salaryMax ?? job.salaryMin,
        unitText: PERIOD_UNIT[job.salaryPeriod ?? "year"] ?? "YEAR",
      },
    };
  }
}

// Disambiguate the <title> when the same title+company posts in several
// locations; prefer the short city over the (possibly multi-office) raw string.
const titleDisambig = job.city ?? country ?? location;
const pageTitle =
  dupTitle && titleDisambig
    ? `${job.title} · ${job.companyName} · ${titleDisambig}`
    : `${job.title} · ${job.companyName}`;

// Tombstones can outlive their company page (it's only built while the company
// has open roles) — don't link into a 404.
const companyPageExists = openJobs.some((j) => j.companySlug === job.companySlug);

const descBits = [
  `${job.title} at ${job.companyName}`,
  [location, remoteLabel(job.remoteType)].filter(Boolean).join(", "),
  salary,
  job.skills.length ? `Skills: ${job.skills.slice(0, 3).join(", ")}` : null,
].filter(Boolean);
const metaDescription = `${descBits.join(" — ")}.`.slice(0, 300);
---

<Base
  title={pageTitle}
  description={metaDescription}
  noindex={closed}
>
  <article class="job-detail">
    <p><a class="back" href={url("/")}>← All jobs</a></p>
    {closed && (
      <p class="closed-banner" role="status">
        This role has closed — it no longer appears on {job.companyName}'s careers site.
        {similar.length > 0 && "Similar open roles are listed below."}
      </p>
    )}
    <h1>{job.title}</h1>
    <p class="company">
      {companyPageExists ? (
        <a href={url(`/companies/${job.companySlug}/`)}>{job.companyName}</a>
      ) : (
        job.companyName
      )}
    </p>
    {facts.length > 0 && (
      <dl class="facts">
        {facts.map((f) => (
          <div class="fact">
            <dt>{f.label}</dt>
            <dd class={f.muted ? "muted" : f.label === "Salary" ? "salary" : undefined}>{f.value}</dd>
          </div>
        ))}
      </dl>
    )}
    {!closed && applyHref && (
      <p class="apply-wrap top-apply">
        <a class="apply" href={applyHref} target="_blank" rel="noopener noreferrer nofollow">
          Apply on company site <span aria-hidden="true">→</span><span class="sr-only">(opens in new tab)</span>
        </a>
      </p>
    )}
    {skills.length > 0 && (
      <div class="meta skills">
        {skills.map((s) => <span class="badge skill">{s}</span>)}
        {moreSkills > 0 && <span class="badge more">+{moreSkills} more</span>}
      </div>
    )}
    {blocks.length > 0 ? (
      <div class="desc">
        {blocks.map((b) =>
          b.type === "ul" ? (
            <ul>{b.items.map((it) => <li>{it}</li>)}</ul>
          ) : (
            <p>{b.text}</p>
          ),
        )}
      </div>
    ) : (
      !closed && (
        <p class="desc no-desc">
          The full job description is on {job.companyName}'s careers site — use the
          apply link to read it.
        </p>
      )
    )}
    {!closed && applyHref && blocks.length > 0 && (
      <p class="apply-wrap">
        <a class="apply" href={applyHref} target="_blank" rel="noopener noreferrer nofollow">
          Apply on company site <span aria-hidden="true">→</span><span class="sr-only">(opens in new tab)</span>
        </a>
      </p>
    )}
  </article>

  {(atCompany.length > 0 || similar.length > 0) && (
    <aside class="related">
      {atCompany.length > 0 && (
        <>
          <h2>More at {job.companyName}</h2>
          <ul class="jobs">
            {atCompany.map((j) => (
              <JobCard job={j} href={url(`/jobs/${j.slug}/`)} />
            ))}
          </ul>
        </>
      )}
      {similar.length > 0 && (
        <>
          <h2>Similar roles</h2>
          <ul class="jobs">
            {similar.map((j) => (
              <JobCard job={j} href={url(`/jobs/${j.slug}/`)} />
            ))}
          </ul>
        </>
      )}
    </aside>
  )}

  {jsonLd && (
    <script type="application/ld+json" set:html={jsonLdScript(jsonLd)} is:inline />
  )}
</Base>

<style>
  .job-detail { max-width: 720px; padding: 32px 0 0; }
  .job-detail h1 {
    font-size: 1.8rem;
    letter-spacing: -0.02em;
    margin: 12px 0 6px;
    overflow-wrap: anywhere;
  }
  .job-detail .company { margin: 0 0 16px; }
  .job-detail .company a { color: var(--accent-text); }
  .job-detail .company a:hover { text-decoration: underline; }
  .closed-banner {
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    padding: 12px 16px;
    color: var(--text);
    margin: 16px 0 0;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1px;
    margin: 0 0 8px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .facts .fact { background: var(--surface); padding: 12px 14px; }
  .facts dt {
    color: var(--muted);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 4px;
  }
  .facts dd { margin: 0; font-size: 0.95rem; font-weight: 600; }
  .facts dd.salary { color: var(--accent-2); }
  .facts dd.muted { color: var(--muted); font-weight: 500; }
  .job-detail .meta { display: flex; flex-wrap: wrap; gap: 8px; }
  .job-detail .skills { margin-top: 16px; }
  .badge.more { color: var(--muted); }
  .desc { margin-top: 28px; color: var(--text); line-height: 1.7; }
  .desc.no-desc { color: var(--muted); }
  .desc p { margin: 0 0 14px; }
  .desc ul { margin: 0 0 14px; padding-left: 1.25rem; }
  .desc li { margin: 0 0 6px; }
  .desc li:last-child { margin-bottom: 0; }
  .desc > :last-child { margin-bottom: 0; }
  .apply-wrap { margin-top: 28px; }
  .apply-wrap.top-apply { margin-top: 20px; }
  .apply {
    display: inline-block;
    background: var(--accent-strong);
    color: #fff;
    padding: 12px 20px;
    border-radius: 10px;
    font-weight: 600;
  }
  .apply:hover { filter: brightness(1.12); }
  .related { max-width: 720px; margin-top: 40px; }
  .related h2 { font-size: 1.1rem; margin: 24px 0 12px; }
</style>
