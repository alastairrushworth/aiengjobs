---
import type { InferGetStaticPropsType } from "astro";
import Base from "../../layouts/Base.astro";
import JobCard from "../../components/JobCard.astro";
import BrowseNav from "../../components/BrowseNav.astro";
import { url } from "../../lib/url.ts";
import { kUsd, median, percentile, salaryMidpointUsd } from "../../lib/format.ts";
import { jsonLdScript } from "../../lib/jsonld.ts";
import { openJobs, fxRates, generatedAt } from "../../lib/data.ts";
import { countryName } from "../../lib/format.ts";
import { CLUSTER_PAGES, salarySlug } from "../../lib/clusters.ts";

export function getStaticPaths() {
  return CLUSTER_PAGES.map((page) => {
    // Every role with a usable published range, any currency — midpoints are
    // annualized + converted to USD (live FX from the snapshot), and implausible
    // parses are dropped by salaryMidpointUsd's floor/ceiling.
    const salaried = openJobs
      .map((job) => ({ job, mid: salaryMidpointUsd(job, fxRates) }))
      .filter(
        (x): x is { job: (typeof openJobs)[number]; mid: number } =>
          x.mid !== null && x.job.clusters.includes(page.id),
      )
      .sort((a, b) => b.mid - a.mid);
    return { params: { cluster: salarySlug(page.id) }, props: { page, salaried } };
  });
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page, salaried } = Astro.props as Props;

const mids = salaried.map((x) => x.mid);
const stats =
  mids.length > 0
    ? {
        count: mids.length,
        p10: percentile(mids, 10),
        median: median(mids),
        p90: percentile(mids, 90),
      }
    : null;

const roleNoun = page.label.replace(/ \/.*/, "");
const canonical = new URL(url(`/salaries/${salarySlug(page.id)}/`), Astro.site).href;

// The distribution above is the content here; the listing is supporting
// evidence, so show the best-paid slice rather than all 470+ cards (which made
// this a 290KB page). Capped, not paginated — paginating would spawn near-
// duplicate pages sharing one stats block. Every role stays reachable via the
// cluster page, its company page and the sitemap.
const MAX_LISTED = 100;
const listed = salaried.slice(0, MAX_LISTED);
const unlisted = salaried.length - listed.length;

// The countries this cluster's priced roles are actually in — the salary
// distribution is computed across all of them, so the Occupation markup's
// occupationLocation should reflect that, not just the single modal country.
const countryTally = new Map<string, number>();
for (const { job } of salaried) {
  if (job.country) countryTally.set(job.country, (countryTally.get(job.country) ?? 0) + 1);
}
const topCountries = [...countryTally.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 3)
  .map(([code]) => code);
if (topCountries.length === 0) topCountries.push("US");

const jsonLd = stats
  ? {
      "@context": "https://schema.org",
      "@type": "Occupation",
      name: `${roleNoun} (AI engineering)`,
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonical,
        lastReviewed: generatedAt.slice(0, 10),
      },
      occupationLocation: topCountries.map((code) => ({
        "@type": "Country",
        name: countryName(code) ?? code,
      })),
      estimatedSalary: {
        "@type": "MonetaryAmountDistribution",
        name: "base",
        currency: "USD",
        duration: "P1Y",
        median: Math.round(stats.median),
        percentile10: Math.round(stats.p10),
        percentile90: Math.round(stats.p90),
      },
    }
  : null;
---

<Base
  title={`${roleNoun} salaries — AI engineering pay data`}
  description={
    stats
      ? `${roleNoun} salaries from ${stats.count} live roles: median ${kUsd(stats.median)}, typical range ${kUsd(stats.p10)}–${kUsd(stats.p90)} (USD/yr).`
      : `${roleNoun} salary data from live AI-engineering roles.`
  }
>
  <section class="hero" style="padding-bottom:8px">
    <h1>{roleNoun} salaries</h1>
    <p>
      Live salary data from first-party {page.label} postings — pay ranges
      employers actually publish, converted to USD/yr. No surveys.
    </p>
  </section>

  {stats ? (
    <>
      <div class="salary-stats">
        <div><span class="num">{kUsd(stats.median)}</span><span class="lbl">median</span></div>
        <div><span class="num">{kUsd(stats.p10)}</span><span class="lbl">10th percentile</span></div>
        <div><span class="num">{kUsd(stats.p90)}</span><span class="lbl">90th percentile</span></div>
        <div><span class="num">{stats.count}</span><span class="lbl">data points</span></div>
      </div>

      <h2 style="margin-top:28px;font-size:1.1rem">
        {unlisted > 0
          ? `Top ${listed.length} best-paid roles with published pay`
          : "Roles with published pay"}
      </h2>
      <ul class="jobs">
        {listed.map(({ job }) => (
          <JobCard job={job} href={url(`/jobs/${job.slug}/`)} />
        ))}
      </ul>
      {unlisted > 0 && (
        <p style="text-align:center;padding:20px 0">
          <a class="back" href={url(`/${page.slug}/`)}>
            + {unlisted} more {page.label} role{unlisted === 1 ? "" : "s"} with published pay →
          </a>
        </p>
      )}
    </>
  ) : (
    <p style="text-align:center;color:var(--muted);padding:32px 0">
      No published salary data for {page.label} roles yet — check back as more roles are ingested.
    </p>
  )}

  <BrowseNav
    label="More:"
    links={[
      { href: url(`/${page.slug}/`), text: `All ${page.label} jobs →` },
      ...CLUSTER_PAGES.filter((p) => p.id !== page.id).map((p) => ({
        href: url(`/salaries/${salarySlug(p.id)}/`),
        text: `${p.label} pay`,
      })),
    ]}
  />

  {jsonLd && <script type="application/ld+json" set:html={jsonLdScript(jsonLd)} is:inline />}
</Base>
