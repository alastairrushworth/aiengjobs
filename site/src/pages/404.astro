---
import Base from "../layouts/Base.astro";
import BrowseNav from "../components/BrowseNav.astro";
import { url } from "../lib/url.ts";
import { CLUSTER_PAGES } from "../lib/clusters.ts";
---

{/* GitHub Pages serves this file's body at whatever URL 404'd, so the default
    self-canonical would point at /404/ — a URL that itself doesn't exist.
    Point it at the board root instead. It's noindexed either way. */}
<Base title="Page not found" noindex canonicalOverride={url("/")}>
  <section class="hero">
    <h1>That page doesn't exist</h1>
    {/* Two things 404 here, and the copy used to name only the first. Listing
        pages come and go as well: a city page exists while the city clears
        MIN_CITY_JOBS, so one closed requisition can retire /ai-jobs-seoul/
        after Google has indexed it. Telling that visitor "the role has closed"
        is simply wrong. */}
    <p>
      If you followed a link to a job, the role has probably closed and been
      removed from the board — listings are re-verified nightly.
    </p>
    <p>
      If you were after a city or topic page, it may no longer have enough open
      roles to list. Everything currently on the board is below.
    </p>
  </section>

  <BrowseNav
    center
    ariaLabel="Where to go next"
    links={[
      { href: url("/"), text: "Browse all jobs" },
      ...CLUSTER_PAGES.map((p) => ({ href: url(`/${p.slug}/`), text: p.label })),
      { href: url("/stats/"), text: "Stats" },
    ]}
  />
</Base>
