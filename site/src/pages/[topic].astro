---
import type { InferGetStaticPropsType } from "astro";
import Base from "../layouts/Base.astro";
import JobCard from "../components/JobCard.astro";
import { url } from "../lib/url.ts";
import { jsonLdScript } from "../lib/jsonld.ts";
import { openJobs } from "../lib/data.ts";
import { CLUSTER_PAGES } from "../lib/clusters.ts";

export function getStaticPaths() {
  return CLUSTER_PAGES.map((page) => ({
    params: { topic: page.slug },
    props: { page, jobs: openJobs.filter((j) => j.clusters.includes(page.id)) },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page, jobs } = Astro.props as Props;

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: page.h1,
  numberOfItems: jobs.length,
  itemListElement: jobs.slice(0, 50).map((j, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(url(`/jobs/${j.slug}/`), Astro.site).href,
    name: `${j.title} — ${j.companyName}`,
  })),
};

const others = CLUSTER_PAGES.filter((p) => p.id !== page.id);
---

<Base title={page.h1} description={`${page.intro} ${jobs.length} open roles right now.`}>
  <section class="hero" style="padding-bottom:8px">
    <h1>{page.h1}</h1>
    <p>{page.intro}</p>
    <p class="count">{jobs.length} open role{jobs.length === 1 ? "" : "s"}</p>
  </section>

  <p style="margin:8px 0"><a class="back" href={url("/")}>← All jobs</a></p>

  <ul class="jobs">
    {jobs.map((job) => <JobCard job={job} href={url(`/jobs/${job.slug}/`)} />)}
  </ul>
  {jobs.length === 0 && (
    <p style="text-align:center;color:var(--muted);padding:32px 0">
      No open roles in this category right now.
    </p>
  )}

  <nav class="browse" style="margin-top:40px" aria-label="Related pages">
    <span style="color:var(--muted);font-size:.85rem">Browse:</span>
    {others.map((p) => <a href={url(`/${p.slug}/`)}>{p.label}</a>)}
    <a href={url(`/salaries/${page.id}/`)}>{page.label} salaries →</a>
  </nav>

  <script type="application/ld+json" set:html={jsonLdScript(itemList)} is:inline />
</Base>
