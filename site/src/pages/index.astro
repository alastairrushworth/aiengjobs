---
import Base from "../layouts/Base.astro";
import JobCard from "../components/JobCard.astro";
import JobFilters from "../components/JobFilters.astro";
import { url } from "../lib/url.ts";
import { buildFilterOptions } from "../lib/filterOptions.ts";
import { openJobs, generatedAt } from "../lib/data.ts";
import { jsonLdScript } from "../lib/jsonld.ts";

const jobs = openJobs; // newest first (see lib/data)

// The landing view server-renders only the newest INITIAL cards; the rest ship
// as a compact JSON payload and hydrate on the first filter/sort/show-all
// interaction. Keeps the HTML small without hiding ~1,000 rendered cards.
const INITIAL = 50;
const initialJobs = jobs.slice(0, INITIAL);

// Filter options counted against the whole board (see lib/filterOptions) —
// every landing builds the same lists against its own roles.
const filterOptions = buildFilterOptions(jobs);

// The full job list ships separately as /jobs-data.json (see lib/jobsPayload)
// and is fetched by the filter script on first interaction, so index.html
// stays a constant size as the board grows.

// Matches the canonical Base.astro emits: the trailing-slash form GitHub Pages
// serves. Not `${url("/")}/` — with base "/" that yields "//", and
// new URL("//", site) throws. Under a non-root base url("/") drops the trailing
// slash instead, so the check below covers both.
const homePath = url("/");
const homeUrl = new URL(homePath.endsWith("/") ? homePath : `${homePath}/`, Astro.site).href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "frontierroles.com",
    url: homeUrl,
    description:
      "The job board for AI developers — RAG, agents, evals, inference. First-party roles pulled nightly from company career sites.",
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Newest AI engineering jobs",
    // The count has to match the list actually emitted, not the whole board —
    // only the newest INITIAL cards are server-rendered here.
    numberOfItems: initialJobs.length,
    itemListElement: initialJobs.map((j, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: new URL(url(`/jobs/${j.slug}/`), Astro.site).href,
      name: `${j.title} — ${j.companyName}`,
    })),
  },
];

const updated = new Date(generatedAt).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<Base title="AI Engineering Jobs — RAG, agents, evals, inference" noBrandSuffix>
  <section class="hero">
    <h1>The job board for AI developers</h1>
    <p>
      Browse <span class="count">{jobs.length}</span> first-party roles in AI research,
      agents, evals and inference.
    </p>
  </section>

  {/* The "Browse by stack" rail used to sit here. It cost a row of the fold on
      every device, and on a phone it was a sideways scroller with no visible
      affordance — six of the eight cluster links were off-screen and nothing
      said so, which is a poor way to expose the pages search traffic lands on.
      All eight now live in the footer nav, on every page, wrapping normally.
      The role-type select covers the same ground for anyone already here. */}

  <JobFilters
    src={url("/jobs-data.json")}
    jobBase={url("/jobs/")}
    logoBase={url("/logos/")}
    total={jobs.length}
    initial={INITIAL}
    noun="open roles"
    {...filterOptions}
  >
    <ul class="jobs" id="jobs">
      {initialJobs.map((job, i) => (
        <JobCard job={job} href={url(`/jobs/${job.slug}/`)} eager={i < 6} />
      ))}
    </ul>
  </JobFilters>

  {/* The location row that sat here is gone. City landings keep their internal
      links from the cross-link row at the foot of every landing page (see
      LandingPage.astro) — the homepage reaches them through the footer nav's
      cluster pages — and the City select in the filter bar covers the same
      ground for anyone already here. */}

  {/* The freshness stamp sits at the foot of the page rather than under the
      headline: it answers a question you only ask after reading the listings. */}
  <p class="updated">Updated {updated} · refreshed nightly</p>

  {/* jsonLdScript escapes <, >, & — job titles are untrusted feed content that
      could otherwise break out of these script elements. */}
  {jsonLd.map((block) => (
    <script type="application/ld+json" set:html={jsonLdScript(block)} is:inline />
  ))}
</Base>
