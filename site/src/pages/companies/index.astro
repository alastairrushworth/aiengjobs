---
import Base from "../../layouts/Base.astro";
import {
  companyBySlug,
  companyPageIndexable,
  fxRates,
  openJobsByCompany,
  MIN_INDEXED_COMPANY_ROLES,
} from "../../lib/data.ts";
import { formatCount, kUsd, median, salaryMidpointUsd } from "../../lib/format.ts";
import { url } from "../../lib/url.ts";

/**
 * Every employer with a page here, with what it is hiring.
 *
 * Company pages were linked from their own roles' pages and from nowhere
 * else, so a crawler that wasn't fetching job pages — and Google wasn't —
 * never reached them. This directory is linked from the footer of every
 * page, which puts every employer two hops from anywhere.
 *
 * Only employers whose page is offered for indexing are listed
 * (MIN_INDEXED_COMPANY_ROLES): a link to a one-role page sends the crawl to a
 * noindexed copy of a job page, and the reader to a page that says less than
 * the card they could have clicked.
 */

interface Row {
  slug: string;
  name: string;
  count: number;
  medianUsd: number | null;
}

const MIN_PRICED_FOR_MEDIAN = 3; // as lib/companyHiring

const rows: Row[] = [...openJobsByCompany]
  .filter(([slug]) => companyPageIndexable(slug))
  .map(([slug, jobs]) => {
    const mids = jobs
      .map((j) => salaryMidpointUsd(j, fxRates))
      .filter((m): m is number => m !== null);
    return {
      slug,
      name: companyBySlug.get(slug)?.name ?? slug,
      count: jobs.length,
      medianUsd: mids.length >= MIN_PRICED_FOR_MEDIAN ? median(mids) : null,
    };
  });

const byCount = [...rows].sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
const TOP = 20;
const top = byCount.slice(0, TOP);

// A–Z, under a letter heading each — the shape a reader scans for a name.
const groups = new Map<string, Row[]>();
for (const r of [...rows].sort((a, b) => a.name.localeCompare(b.name))) {
  const first = r.name[0]?.toUpperCase() ?? "#";
  const key = /[A-Z]/.test(first) ? first : "#";
  const list = groups.get(key);
  if (list) list.push(r);
  else groups.set(key, [r]);
}

const singles = openJobsByCompany.size - rows.length;
const totalRoles = rows.reduce((n, r) => n + r.count, 0);

const title = "Companies hiring AI engineers";
const description =
  `${formatCount(rows.length)} employers with ${formatCount(totalRoles)} open AI-engineering roles, ` +
  `each with its live count and median pay where published — first-party postings from company career sites.`;
---

<Base title={title} description={description}>
  <section class="hero" style="padding-bottom:8px">
    <h1>{title}</h1>
    <p>
      {formatCount(rows.length)} employers with {formatCount(MIN_INDEXED_COMPANY_ROLES)} or more open
      AI-engineering roles — {formatCount(totalRoles)} roles between them, pulled from their own
      career sites.
      {singles > 0 && ` ${formatCount(singles)} more have a single open role, listed on the board.`}
    </p>
  </section>

  <section class="group">
    <h2>Hiring most</h2>
    <ol class="top">
      {top.map((c) => (
        <li>
          <a href={url(`/companies/${c.slug}/`)}>{c.name}</a>
          <span class="n">{formatCount(c.count)} role{c.count === 1 ? "" : "s"}</span>
          {c.medianUsd !== null && <span class="pay">median {kUsd(c.medianUsd)}</span>}
        </li>
      ))}
    </ol>
  </section>

  {[...groups].map(([letter, list]) => (
    <section class="group">
      <h2>{letter}</h2>
      <p class="line">
        {list.map((c) => (
          <span class="item">
            <a href={url(`/companies/${c.slug}/`)}>{c.name}</a>
            <span class="n">{formatCount(c.count)}</span>
          </span>
        ))}
      </p>
    </section>
  ))}
</Base>

<style>
  .group { padding: 12px 0; border-top: 1px solid var(--border); }
  .group h2 { font-size: 1rem; margin: 0 0 6px; }
  .top {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 2px 20px;
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .top li { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .top a { color: var(--text); display: inline-block; padding-block: 4px; }
  .top a:hover { color: var(--accent-text); }
  .n { color: var(--muted); font-size: 0.8rem; }
  .pay { color: var(--muted); font-size: 0.8rem; }
  .line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 14px;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .line .item { white-space: nowrap; }
  .line .n { margin-left: 3px; }
  .line a { color: var(--accent-text); display: inline-block; padding-block: 4px; min-width: 24px; }
  .line a:hover { text-decoration: underline; }
</style>
