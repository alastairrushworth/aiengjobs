---
import type { InferGetStaticPropsType } from "astro";
import Base from "../../layouts/Base.astro";
import JobCard from "../../components/JobCard.astro";
import BrowseNav from "../../components/BrowseNav.astro";
import { CLUSTER_PAGES } from "../../lib/clusters.ts";
import { url } from "../../lib/url.ts";
import { jsonLdScript } from "../../lib/jsonld.ts";
import { openJobs, companies } from "../../lib/data.ts";
import type { Job } from "@aiengjobs/shared";

export function getStaticPaths() {
  const byCompany = new Map<string, Job[]>();
  for (const j of openJobs) {
    const list = byCompany.get(j.companySlug) ?? [];
    list.push(j);
    byCompany.set(j.companySlug, list);
  }
  return companies
    .filter((c) => byCompany.has(c.slug))
    .map((company) => ({
      params: { slug: company.slug },
      props: { company, jobs: byCompany.get(company.slug)! },
    }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { company, jobs } = Astro.props as Props;

// Company domains come from seed data, but validate the shape anyway before
// composing a URL from it.
const domainHref =
  company.domain && /^[a-z0-9.-]+\.[a-z]{2,}$/i.test(company.domain)
    ? `https://${company.domain}`
    : null;

// Distinct stack across this company's roles.
const stack = [...new Set(jobs.flatMap((j) => j.skills))].slice(0, 14);
const withSalary = jobs.filter((j) => j.salaryMin || j.salaryMax).length;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: company.name,
  ...(domainHref ? { url: domainHref } : {}),
};
---

<Base
  title={`${company.name} AI engineering jobs`}
  description={`Open AI-engineering roles at ${company.name}${stack.length ? ` — ${stack.slice(0, 6).join(", ")}.` : "."}`}
>
  <section class="hero" style="padding-bottom:8px;text-align:left">
    <p style="margin:0"><a class="back" href={url("/")}>← All jobs</a></p>
    <h1>{company.name}</h1>
    <p>
      {jobs.length} open AI-engineering role{jobs.length === 1 ? "" : "s"}
      {withSalary > 0 ? ` · ${withSalary} with salary` : ""}
      {company.stage ? ` · ${company.stage}-stage` : ""}
      {domainHref ? (
        <>
          {" · "}
          <a
            href={domainHref}
            target="_blank"
            rel="noopener noreferrer nofollow"
            style="color:var(--accent-text)"
          >{company.domain}<span class="sr-only"> (opens in new tab)</span></a>
        </>
      ) : null}
    </p>
  </section>

  {stack.length > 0 && (
    <div class="meta" style="margin:6px 0 20px;display:flex;flex-wrap:wrap;gap:8px">
      {stack.map((s) => <span class="badge skill">{s}</span>)}
    </div>
  )}

  <ul class="jobs">
    {jobs.map((job) => <JobCard job={job} href={url(`/jobs/${job.slug}/`)} />)}
  </ul>

  <BrowseNav
    label="Browse:"
    links={[
      ...CLUSTER_PAGES.map((p) => ({ href: url(`/${p.slug}/`), text: p.label })),
      { href: url("/salaries/"), text: "Salaries" },
    ]}
  />

  <script type="application/ld+json" set:html={jsonLdScript(jsonLd)} is:inline />
</Base>
