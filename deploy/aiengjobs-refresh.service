[Unit]
Description=aiengjobs nightly ATS ingest + snapshot push
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/aiengjobs
EnvironmentFile=/etc/aiengjobs.env
# A full LLM ingest is long, but connector fetches now time out individually —
# this is just a backstop so a wedged run can't block the nightly timer forever.
TimeoutStartSec=6h
ExecStart=/home/deploy/aiengjobs/scripts/droplet-refresh.sh
